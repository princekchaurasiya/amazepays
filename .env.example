APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
# Optional: your PC IPv4 (same Wi‑Fi) so Vite HMR works when opening the site from a phone. Example: VITE_DEV_HOST=192.168.1.24
# VITE_DEV_HOST=
#
# Mobile dev (Android emulator hits host as 10.0.2.2; iOS Simulator uses localhost):
#   composer run serve:mobile
#   App base URL must be http://10.0.2.2:8000 (colon before port, not a dot).
# SANCTUM_STATEFUL_DOMAINS defaults include 10.0.2.2; override only if needed (comma-separated).

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=star5ott.cshkm543nyjd.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=amazepays_uat
DB_USERNAME=admin
DB_PASSWORD="Star5ott123"

# Automated tests: phpunit.xml forces DB_DATABASE=amazpey_test (create that DB locally).
# RefreshDatabase will only migrate:fresh that database, not DB_DATABASE above.

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# phpredis (ext-redis) or predis; use predis if the PHP redis extension is not installed
# REDIS_CLIENT=predis
# HTTP rate limiting via Redis (optional). Leave false without a running Redis server.
RATE_LIMITER_USE_REDIS=false

