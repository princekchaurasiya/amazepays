# Copy to `.env.testing` if you prefer a full testing env file (optional).
# PHPUnit always forces DB_DATABASE=amazpey_test via phpunit.xml so RefreshDatabase
# never touches your working database — as long as you create that empty DB in MySQL.
#
#   mysql -u root -e "CREATE DATABASE IF NOT EXISTS amazpey_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
#
# Then match DB_HOST / DB_USERNAME / DB_PASSWORD to your machine (e.g. XAMPP).

APP_NAME=AmazePaysTesting
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amazpey_test
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

MAIL_MAILER=array

# After copying: php artisan key:generate --env=testing
